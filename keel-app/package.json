{
  "name": "keel",
  "version": "0.7.9",
  "description": "Keel: my personal futures trading bot.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "predist": "node scripts/ensure-electron.js",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^38.0.0",
    "electron-builder": "^25.0.0",
    "lightweight-charts": "^5.2.1",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.keel.personal",
    "productName": "Keel",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keel",
      "artifactName": "Keel-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.keeltrading.net/"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "electron-updater": "^6.3.9",
    "https-proxy-agent": "^9.1.0",
    "protobufjs": "^7.4.0",
    "ws": "^8.18.0"
  }
}
